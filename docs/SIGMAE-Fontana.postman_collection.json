{
  "info": {
    "_postman_id": "7fe17371-0cd7-4cc7-9a87-5d79188c1001",
    "name": "SIGMAE Fontana API",
    "description": "Coleccion de sustentacion para validar autenticacion, catalogos, estudiantes, acudientes, talanquera, novedades y dashboard.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.environment.get('runSuffix')) {",
          "  const suffix = Date.now().toString();",
          "  pm.environment.set('runSuffix', suffix);",
          "  pm.environment.set('codigoEstudiante', `EST-PM-${suffix}`);",
          "  pm.environment.set('documentoEstudiante', `9${suffix}`);",
          "  pm.environment.set('documentoAcudiente', `8${suffix}`);",
          "  pm.environment.set('correoAcudiente', `acudiente.pm.${suffix}@example.com`);",
          "}"
        ]
      }
    }
  ],
