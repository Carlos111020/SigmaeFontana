              "raw": "{\n  \"codigoEstudiantil\": \"{{codigoEstudiante}}\",\n  \"documento\": \"{{documentoEstudiante}}\",\n  \"nombres\": \"Prueba\",\n  \"apellidos\": \"Postman\",\n  \"gradoId\": {{gradoId}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/estudiantes",
              "host": [
