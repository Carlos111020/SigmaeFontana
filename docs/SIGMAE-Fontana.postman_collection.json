    {
      "name": "Gestion academica",
      "item": [
        {
          "name": "Listar grados",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('lista grados OK', () => pm.response.to.have.status(200));",
                  "const grados = pm.response.json();",
                  "const grado = grados.find(item => item.nombre === '6A') || grados[0];",
                  "pm.environment.set('gradoId', grado.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/grados?activo=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "grados"
              ],
              "query": [
                {
                  "key": "activo",
                  "value": "true"
                }
              ]
            }
          }
        },
        {
          "name": "Crear estudiante de sustentacion",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
