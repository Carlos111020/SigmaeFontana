              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login administrador OK', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.environment.set('adminToken', data.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"admin@sigmae.edu.co\",\n  \"password\": \"Admin123*\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
